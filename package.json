{
  "name": "dotmerlingame",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "pretest": "npm run tools:rgbds && npm run roms:build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "tools:rgbds": "node scripts/fetch-rgbds.ts",
    "core:build": "sh scripts/build-core.sh",
    "core:verify": "sh scripts/build-core.sh && git diff --exit-code -- src/adapters/emulator/sameboy/generated",
    "roms:build": "node scripts/build-test-roms.ts",
    "bootrom:build": "node scripts/build-bootrom.ts",
    "licenses": "node scripts/check-licenses.ts",
    "licenses:generate": "node scripts/generate-third-party.ts",
    "secrets": "node scripts/check-secrets.ts",
    "check": "npm run lint && npm run test && npm run bootrom:build && git diff --exit-code -- src/core/rom/logo-hash.generated.ts src/adapters/emulator/bootrom/generated && npm run build && npm run test:e2e && npm run licenses && npm run secrets"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.3",
    "license-checker-rseidelsohn": "5.0.1",
    "secretlint": "13.0.7",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
